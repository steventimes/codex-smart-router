{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 1 },
    "candidateId": { "type": ["string", "null"] },
    "abstain": { "type": "boolean" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "taskType": {
      "type": "string",
      "enum": ["conversation", "lookup", "transformation", "implementation", "debugging", "infrastructure", "research", "architecture", "high_risk", "other"]
    },
    "scope": { "type": "string", "enum": ["tiny", "focused", "multi_file", "repository", "unknown"] },
    "ambiguity": { "type": "string", "enum": ["low", "medium", "high", "unknown"] },
    "risk": { "type": "string", "enum": ["low", "medium", "high", "unknown"] },
    "verifiability": { "type": "string", "enum": ["strong", "partial", "weak", "unknown"] },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["semantic_match", "baseline_preserved", "risk", "ambiguity", "context_incomplete", "verified_failure", "policy_evidence", "budget", "capability"]
      },
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true
    }
  },
  "required": ["schemaVersion", "candidateId", "abstain", "confidence", "taskType", "scope", "ambiguity", "risk", "verifiability", "reasonCodes"],
  "additionalProperties": false
}
