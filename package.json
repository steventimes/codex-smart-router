{
  "name": "codex-smart-router",
  "version": "0.2.0",
  "description": "Catalog-driven model and reasoning router for the native Codex App Server",
  "type": "module",
  "files": [
    "bin/",
    "src/",
    "assets/route-schema.json",
    "assets/pricing.json",
    "assets/benchmark/",
    "docs/MIGRATION.md",
    "README.md",
    "PUBLIC_DOCUMENTATION.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "codex-smart": "bin/codex-smart.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
